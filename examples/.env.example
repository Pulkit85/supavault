# Supabase or PostgreSQL Connection Details
SUPAVAULT_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPAVAULT_PORT=5432
SUPAVAULT_DATABASE=postgres
SUPAVAULT_USER=postgres
SUPAVAULT_PASSWORD=your_database_password_here
SUPAVAULT_SSL=require

# Optional Backup Output Directory
SUPAVAULT_OUT_DIR=./backups
