{
  "name": "supavault",
  "version": "1.0.0",
  "description": "Zero-config standalone backup & restore engine for Supabase and PostgreSQL databases",
  "main": "dist/index.js",
  "bin": {
    "supavault": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "supabase",
    "postgresql",
    "backup",
    "restore",
    "pg_dump",
    "pg_restore",
    "database-tools",
    "devops"
  ],
  "author": "Pulkit Bisht (Fawru)",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
